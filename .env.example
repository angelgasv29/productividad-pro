# Copia este archivo a `.env` y ajusta los valores.
# En producción usa una SECRET_KEY larga, aleatoria y distinta a la de desarrollo.

SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DATABASE_URL=sqlite:///data/productividad_pro.db
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGICAL_CUTOFF_HOUR=4
MAX_IMPORT_BYTES=26214400
DEBUG=false
